{
  "name": "kavikemail",
  "version": "1.0.2",
  "description": "Official JavaScript and TypeScript SDK for the Kavik.email email verification API",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.check.json",
    "test": "node --import ./test/resolve-ts.mjs --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "email",
    "verification",
    "validation",
    "api",
    "sdk",
    "kavik",
    "email-validation",
    "email-verification",
    "disposable-email",
    "smtp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kavik-email/kavik-node.git"
  },
  "homepage": "https://kavik.email/docs/sdks/",
  "bugs": {
    "url": "https://github.com/kavik-email/kavik-node/issues"
  }
}
